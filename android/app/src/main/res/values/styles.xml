<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      必须让 WebView 的 prefers-color-scheme 跟随系统。

      原因:WebView 报告的颜色偏好由 Activity 主题的 uiMode 决定,
      不是系统的深色开关。原来的 Theme.Light 会强制 WebView 一律
      报 light —— 所有站点都渲染浅色版;桌面端 Edge 跟随系统,
      于是同一个站在桌面深色、手机浅色。

      DayNight 主题让 uiMode 跟随系统:
        系统深色 → WebView 报 dark → 站点用它自己的深色主题
        系统浅色 → WebView 报 light → 站点用浅色

      我们不改页面内容,由站点决定怎么渲染深色,
      这样不会出现"深底黑字"这类破坏。
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!--
          DayNight 没有 NoTitleBar 变体,必须显式去掉标题栏,
          否则 WebView 页面顶上会多出一条 "PageReader" 的 ActionBar。
        -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
